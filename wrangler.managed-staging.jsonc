{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Managed staging Worker. This is NOT the DIY/prod Worker.
  // Default wrangler.jsonc name stays `bot-my-meals`. Do not deploy this
  // file with the production Workers Build (`scripts/cf-deploy.mjs`).
  //
  // Host: managed-staging.botmymeals.com
  // Attach that hostname in the Cloudflare dashboard
  // (Workers → bot-my-meals-managed-staging → Domains & Routes).
  // Do not uncomment `routes` here — `custom_domain: true` on
  // `wrangler deploy` creates DNS and can surprise the botmymeals.com zone.
  // Runbook: docs/managed-staging.md
  //
  // "routes": [
  //   { "pattern": "managed-staging.botmymeals.com", "custom_domain": true }
  // ]
  "name": "bot-my-meals-managed-staging",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  // Staging-only secrets (dashboard or `wrangler secret put --config wrangler.managed-staging.jsonc`).
  // Stripe test mode only (sk_test_ / pk_test_). Never sk_live_ or pk_live_.
  // Point NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY at a non-prod Supabase.
  // Never put the service-role key here. See docs/managed-staging.md.
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "bot-my-meals-managed-staging"
    }
  ]
}
