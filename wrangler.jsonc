{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Household PWA. Worker name stays `bot-my-meals`. Do not rename.
  //
  // DIY: attach YOUR workers.dev URL or YOUR custom domain in the Cloudflare
  // dashboard. Do not uncomment `routes` here — `wrangler deploy` with
  // custom_domain: true creates DNS. Runbook: docs/domains.md
  //
  // "routes": [
  //   { "pattern": "meals.example.com", "custom_domain": true }
  // ]
  //
  // Do not use {handle}.botmymeals.com — that is not a DIY hostname.
  "name": "bot-my-meals",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  // Optional Worker secrets (dashboard or `wrangler secret put`). Never NEXT_PUBLIC_.
  // Do not add a vars block — Workers Builds drops plain-text vars that are not listed here.
  // BOT_WAKE_WEBHOOK_URL and BOT_WAKE_WEBHOOK_KEY wake the household Grok Bot.
  // CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN let House → Wake your Bot save those two.
  // VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT, and PUSH_DISPATCH_SECRET send web push.
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "bot-my-meals"
    }
  ]
}
